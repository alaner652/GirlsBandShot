# 複製成 deploy.env 後填入你的 VM 連線資訊（deploy.env 不會進 git）
#   cp deploy.env.example deploy.env

# SSH 目標：user@host（可用 ~/.ssh/config 的 Host alias）
DEPLOY_SSH=ubuntu@your-vm-ip

# VM 上的專案路徑（用單引號讓 ~ 留到遠端才展開，或直接寫絕對路徑）
DEPLOY_DIR='~/GirlsBandShot'

# （選填）只部署指定系列的影片，空白＝自動偵測本機所有系列
# DEPLOY_SERIES="yumemita mygo"
